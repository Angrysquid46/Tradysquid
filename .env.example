# Copy this file to .env. Never commit the completed .env file.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1532077258099917020

# Optional: restrict commands to one Discord user ID.
DISCORD_ALLOWED_USER_ID=

TRADIER_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com/v1
SEC_USER_AGENT=
NGROK_AUTHTOKEN=

COMMAND_BOT_HOST=127.0.0.1
COMMAND_BOT_PORT=8080

# Local monitoring uses the laptop and does not consume GitHub Actions minutes.
LOCAL_MARKET_REFRESH_MINUTES=5
LOCAL_FILINGS_REFRESH_MINUTES=30
LOCAL_STATUS_REFRESH_MINUTES=15
LOCAL_ENGINE_POLL_SECONDS=30
# Turn on after DISCORD_BOT_TOKEN is configured locally.
LOCAL_FULL_SCAN_ENABLED=false
