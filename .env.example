# Copy this file to .env. Never commit the completed .env file.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=1532077258099917020

# Optional: restrict commands to one Discord user ID.
DISCORD_ALLOWED_USER_ID=

TRADIER_TOKEN=
TRADIER_BASE_URL=https://api.tradier.com/v1
SEC_USER_AGENT=
NGROK_AUTHTOKEN=

# Shared Tradier budget and cache. The live response headers override the
# configured allowance automatically. Two requests are preserved for
# open-position safety at the end of a rate window.
TRADIER_REQUESTS_PER_MINUTE=125
TRADIER_RATE_SAFETY_RESERVE=2
TRADIER_RATE_MAX_WAIT_SECONDS=70
CANONICAL_DAILY_HISTORY_DAYS=420
QUOTE_CACHE_SECONDS=2

# Event-triggered scans. TradingView/provider events enter this queue instead of
# waiting for the ordinary rotating scan.
TARGETED_SCAN_ENABLED=true
TARGETED_SCAN_MIN_EVENT_PRIORITY=75
TARGETED_SCAN_COOLDOWN_SECONDS=60
TARGETED_SCAN_MAX_SYMBOLS=2
TARGETED_SCAN_MIN_TRADIER_AVAILABLE=12
TARGETED_SCAN_EVENT_PROVIDERS=tradingview,discord_member,robinhood_mcp

# Local volatility evidence. IV Rank and Percentile remain COLLECTING until
# actual daily observations reach the configured sample minimum.
IV_RANK_MIN_SAMPLES=20
IV_RANK_LOOKBACK_SESSIONS=252

# Optional second-PC resource mesh. Leave RESOURCE_MESH_ROOT blank to use a
# local folder and the automatic low-priority fallback on the production PC.
# To use PC 2, set the same authenticated UNC path in .env and .env.worker.
RESOURCE_MESH_ROOT=
RESOURCE_MESH_LOCAL_FALLBACK=true
RESOURCE_MESH_DISPATCH_MINUTES=60
RESOURCE_WORKER_POLL_SECONDS=3
RESOURCE_WORKER_HTTP_TIMEOUT=25
EVENT_RISK_LOOKAHEAD_DAYS=45
OUTCOME_BOOTSTRAP_SAMPLES=1000
OUTCOME_MIN_GROUP_SAMPLES=5

# Optional free-data providers. Missing keys never block Tradier, scanning,
# Discord, position management, deployment, or the worker's no-key sources.
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
BLS_API_KEY=
EIA_API_KEY=
FRED_SERIES=DGS10,DGS2,T10Y2,VIXCLS,BAMLH0A0HYM2,DFII10,FEDFUNDS,UNRATE,CPIAUCSL
BLS_SERIES=LNS14000000,CES0000000001,CUUR0000SA0
EIA_SERIES_IDS=PET.RWTC.D,NG.RNGWHHD.D,STEO.RGDPQ_NONOECD.M

# Free owner-only Discord -> GitHub Issues upgrade batching.
# Use a fine-grained token limited to this repository with Issues read/write.
GITHUB_UPGRADE_TOKEN=
GITHUB_REPOSITORY=Angrysquid46/Tradysquid

# Optional AI-enhanced /ask command. Leave the key blank to use local lessons only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=700
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_USER_COOLDOWN_SECONDS=8

COMMAND_BOT_HOST=127.0.0.1
COMMAND_BOT_PORT=8080

# Local monitoring uses the laptop and does not consume GitHub Actions minutes.
LOCAL_MARKET_REFRESH_MINUTES=5
LOCAL_FILINGS_REFRESH_MINUTES=30
LOCAL_STATUS_REFRESH_MINUTES=15
LOCAL_ENGINE_POLL_SECONDS=15
# Turn on after DISCORD_BOT_TOKEN is configured locally.
LOCAL_FULL_SCAN_ENABLED=false

# Background supervisor and automatic deployment.
SUPERVISOR_AUTO_UPDATE=true
SUPERVISOR_UPDATE_MINUTES=2
SUPERVISOR_HEALTH_SECONDS=30
SUPERVISOR_AUTO_DISCORD_SYNC=true
SUPERVISOR_AUTO_REGISTER_COMMANDS=true
SUPERVISOR_PREVENT_SLEEP=true
SUPERVISOR_LOCK_PORT=8876
