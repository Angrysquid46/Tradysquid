# Copy this file to .env.worker on the optional resource-worker PC.
# This PC does not need Tradier, Discord, ngrok, OpenAI, or deployment secrets.

# Use the same authenticated folder path configured on the production PC.
# Example: \\PRIMARY-PC\TradysquidMesh
RESOURCE_MESH_ROOT=
RESOURCE_WORKER_ID=
RESOURCE_WORKER_POLL_SECONDS=3
RESOURCE_WORKER_HTTP_TIMEOUT=25

# Required for SEC EDGAR requests. Use a real contact as requested by SEC.
SEC_USER_AGENT=Tradysquid research contact your-email@example.com

# Optional free provider keys. Add every key you obtain; missing providers are
# skipped and reported without stopping the worker.
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
BLS_API_KEY=
EIA_API_KEY=

FRED_SERIES=DGS10,DGS2,T10Y2,VIXCLS,BAMLH0A0HYM2,DFII10,FEDFUNDS,UNRATE,CPIAUCSL
BLS_SERIES=LNS14000000,CES0000000001,CUUR0000SA0
EIA_SERIES_IDS=PET.RWTC.D,NG.RNGWHHD.D,STEO.RGDPQ_NONOECD.M
